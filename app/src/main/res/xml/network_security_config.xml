<?xml version="1.0" encoding="utf-8"?>
<!-- K7a: HTTPS-only app. The model download pins an https:// resolve link
     and Hugging Face redirects stay on TLS; cleartext is forbidden for
     every destination and only system CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
